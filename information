    def _draw_nebula(self, canvas: "tk.Canvas", width: int, height: int) -> None:
        """Paints a soft, layered nebula + Milky Way band for depth."""
        rng = random.Random(2024)

        # Base deep-space gradient (top to bottom)
        space_bands = (
            "#01030a", "#02050e", "#030712", "#04091a",
            "#050b1e", "#060d20", "#04091a",
        )
        band_h = height / len(space_bands)
        for i, colour in enumerate(space_bands):
            canvas.create_rectangle(0, i * band_h, width, (i + 1) * band_h,
                                    fill=colour, outline="")

        # Milky Way diagonal band (soft, multi-pass glow)
        for offset, colour, thickness in (
            (-14, "#0a1226", 30),
            (-6,  "#101a35", 22),
            (0,   "#182444", 14),
            (6,   "#101a35", 22),
            (14,  "#0a1226", 30),
        ):
            canvas.create_line(
                -40, height * 0.72 + offset,
                width + 40, height * 0.18 + offset,
                fill=colour, width=thickness,
            )

        # Nebula clouds (concentric translucent ovals, Tkinter has no alpha,
        # so we stack darker colours to fake softness)
        nebulae = (
            (width * 0.22, height * 0.30, 190, "#0c1830"),
            (width * 0.20, height * 0.32, 130, "#122344"),
            (width * 0.24, height * 0.28, 70,  "#1a2f56"),
            (width * 0.78, height * 0.72, 220, "#0e1a2e"),
            (width * 0.80, height * 0.74, 150, "#142645"),
            (width * 0.76, height * 0.70, 80,  "#1c3159"),
            (width * 0.52, height * 0.55, 160, "#0a1526"),
            (width * 0.50, height * 0.56, 90,  "#0f1d33"),
        )
        for cx, cy, r, colour in nebulae:
            canvas.create_oval(cx - r, cy - r * 0.6, cx + r, cy + r * 0.6,
                               fill=colour, outline="")

        # Faint dust specks across the nebula
        for _ in range(220):
            x = rng.randint(0, width)
            y = rng.randint(0, height)
            shade = rng.choice(("#2a3a5c", "#223252", "#1a2745", "#33436a"))
            canvas.create_oval(x, y, x + 1, y + 1, fill=shade, outline="")

    def _draw_starfield(self, canvas: "tk.Canvas", width: int, height: int) -> None:
        """Layered starfield: distant faint stars, mid stars, bright stars."""
        rng = random.Random(91)

        # Layer 1: distant faint stars
        for _ in range(400):
            x = rng.randint(0, width)
            y = rng.randint(0, height)
            shade = rng.choice(("#445c7a", "#3a5069", "#506a88"))
            canvas.create_oval(x, y, x + 1, y + 1, fill=shade, outline="")

        # Layer 2: mid-brightness stars
        for _ in range(160):
            x = rng.randint(0, width)
            y = rng.randint(0, height)
            shade = rng.choice(("#9ab6d4", "#b6cbe2", "#8ea9c7"))
            canvas.create_oval(x, y, x + 1, y + 1, fill=shade, outline="")

        # Layer 3: bright stars with a 4-point sparkle cross
        for _ in range(30):
            x = rng.randint(6, width - 6)
            y = rng.randint(6, height - 6)
            size = rng.choice((1, 1, 2, 2, 3))
            canvas.create_oval(x - size, y - size, x + size, y + size,
                               fill="#f0f6ff", outline="")
            # sparkle rays
            ray = size + 3
            canvas.create_line(x - ray, y, x + ray, y,
                               fill="#c8dcf2", width=1)
            canvas.create_line(x, y - ray, x, y + ray,
                               fill="#c8dcf2", width=1)
            # faint coloured halo (red / blue giants)
            halo_colour = rng.choice(("#5a7fb8", "#b88a6a", "#7aa8c9", "#c9b58a"))
            canvas.create_oval(x - size - 2, y - size - 2,
                               x + size + 2, y + size + 2,
                               outline=halo_colour, width=1)

    def _draw_earth(self, canvas: "tk.Canvas", cx: int, cy: int, r: int) -> None:
        """Photorealistic Earth: atmosphere, oceans, continents, clouds, night side."""
        # --- Outer atmospheric glow (stacked rings for softness) ---
        for i, colour in enumerate(("#0a2038", "#0d2a4a", "#10365e", "#144273")):
            gr = r + 10 - i * 2
            canvas.create_oval(cx - gr, cy - gr, cx + gr, cy + gr,
                               outline=colour, width=2)

        # --- Ocean sphere ---
        canvas.create_oval(cx - r, cy - r, cx + r, cy + r,
                           fill="#0f3a63", outline="#3a7fc0", width=2)

        # --- Continent blobs (Africa/America/Asia shaped approximations) ---
        # Africa-ish
        canvas.create_polygon(
            cx - 2, cy - 22,
            cx + 6, cy - 16,
            cx + 10, cy - 4,
            cx + 6, cy + 10,
            cx - 2, cy + 20,
            cx - 8, cy + 14,
            cx - 10, cy + 2,
            cx - 7, cy - 12,
            fill="#2f7a4a", outline="#3f9a60", width=1,
        )
        # Europe/Asia-ish
        canvas.create_polygon(
            cx + 6, cy - 26,
            cx + 24, cy - 22,
            cx + 30, cy - 10,
            cx + 22, cy - 2,
            cx + 14, cy - 6,
            cx + 8, cy - 14,
            fill="#3a8a52", outline="#4aa368", width=1,
        )
        # Americas-ish (left side, partial)
        canvas.create_polygon(
            cx - 30, cy - 14,
            cx - 20, cy - 18,
            cx - 14, cy - 6,
            cx - 16, cy + 8,
            cx - 22, cy + 18,
            cx - 30, cy + 12,
            cx - 34, cy + 0,
            fill="#2f7a4a", outline="#3f9a60", width=1,
        )
        # Southern landmass (Antarctica hint)
        canvas.create_polygon(
            cx - 14, cy + 26,
            cx + 10, cy + 24,
            cx + 16, cy + 30,
            cx - 18, cy + 32,
            fill="#d8e6ef", outline="#eaf2f8", width=1,
        )

        # --- Cloud swirls (thin white arcs, layered) ---
        cloud_paths = (
            (-r * 0.6, -r * 0.4, -r * 0.1, -r * 0.55),
            (r * 0.05, -r * 0.6,  r * 0.5, -r * 0.35),
            (-r * 0.4,  r * 0.15, r * 0.1,  r * 0.05),
            (r * 0.15,  r * 0.35, r * 0.6,  r * 0.25),
            (-r * 0.7,  r * 0.45, -r * 0.2, r * 0.5),
        )
        for x1, y1, x2, y2 in cloud_paths:
            canvas.create_line(cx + x1, cy + y1, cx + x2, cy + y2,
                               fill="#e8f2fb", width=3, smooth=True)

        # --- Terminator (day/night shadow on the right side) ---
        canvas.create_arc(cx - r, cy - r, cx + r, cy + r,
                          start=250, extent=160, style="chord",
                          fill="#05101c", outline="")
        # Soft terminator blend
        canvas.create_arc(cx - r + 3, cy - r + 3, cx + r - 3, cy + r - 3,
                          start=255, extent=150, style="arc",
                          outline="#0a1a2c", width=4)

        # --- Specular highlight (sun reflection on ocean) ---
        canvas.create_oval(cx - r * 0.55, cy - r * 0.65,
                           cx - r * 0.15, cy - r * 0.25,
                           fill="#7ec4f0", outline="")

        # --- Thin bright rim light on the lit side ---
        canvas.create_arc(cx - r, cy - r, cx + r, cy + r,
                          start=110, extent=140, style="arc",
                          outline="#bfe3ff", width=2)

    def _draw_moon(self, canvas: "tk.Canvas", cx: int, cy: int, r: int) -> None:
        """Detailed Moon: maria, craters with rims, subtle terminator."""
        # --- Base sphere ---
        canvas.create_oval(cx - r, cy - r, cx + r, cy + r,
                           fill="#9a9a96", outline="#c8c8c4", width=2)

        # --- Maria (dark basalt plains) ---
        maria = (
            (-10, -6, 12, 8),
            (10, 2, 9, 6),
            (-2, 12, 7, 5),
            (14, -10, 6, 4),
            (-14, 6, 5, 4),
        )
        for mx, my, mw, mh in maria:
            canvas.create_oval(cx + mx - mw, cy + my - mh,
                               cx + mx + mw, cy + my + mh,
                               fill="#6e6e6a", outline="")

        # --- Craters (deterministic pseudo-random placement) ---
        rng = random.Random(77)
        for _ in range(28):
            angle = rng.uniform(0, math.tau)
            dist = rng.uniform(0, r * 0.85)
            ox = math.cos(angle) * dist
            oy = math.sin(angle) * dist
            cr = rng.uniform(1.5, 4.5)

            # crater floor
            canvas.create_oval(cx + ox - cr, cy + oy - cr,
                               cx + ox + cr, cy + oy + cr,
                               fill="#7a7a76", outline="")
            # bright rim (sunlit edge)
            canvas.create_arc(cx + ox - cr, cy + oy - cr,
                              cx + ox + cr, cy + oy + cr,
                              start=200, extent=140, style="arc",
                              outline="#d8d8d4", width=1)
            # shadow crescent (interior)
            canvas.create_arc(cx + ox - cr + 1, cy + oy - cr + 1,
                              cx + ox + cr - 1, cy + oy + cr - 1,
                              start=20, extent=120, style="arc",
                              outline="#4a4a48", width=1)

        # --- A few larger, prominent craters with ray systems ---
        for (ox, oy, cr) in ((-18, -14, 6), (16, 10, 7), (-6, 20, 5)):
            canvas.create_oval(cx + ox - cr, cy + oy - cr,
                               cx + ox + cr, cy + oy + cr,
                               fill="#84847f", outline="#e0e0da", width=1)
            canvas.create_oval(cx + ox - cr * 0.55, cy + oy - cr * 0.55,
                               cx + ox + cr * 0.55, cy + oy + cr * 0.55,
                               fill="#5f5f5b", outline="")
            # rays
            for k in range(6):
                a = k * (math.tau / 6) + 0.3
                canvas.create_line(
                    cx + ox + math.cos(a) * cr,
                    cy + oy + math.sin(a) * cr,
                    cx + ox + math.cos(a) * (cr + 6),
                    cy + oy + math.sin(a) * (cr + 6),
                    fill="#c8c8c2", width=1,
                )

        # --- Terminator (right side shadow) ---
        canvas.create_arc(cx - r, cy - r, cx + r, cy + r,
                          start=250, extent=160, style="chord",
                          fill="#1c1c1a", outline="")
        canvas.create_arc(cx - r + 3, cy - r + 3, cx + r - 3, cy + r - 3,
                          start=255, extent=150, style="arc",
                          outline="#2c2c28", width=4)

        # --- Rim light on the lit side ---
        canvas.create_arc(cx - r, cy - r, cx + r, cy + r,
                          start=110, extent=140, style="arc",
                          outline="#f0f0ea", width=2)
