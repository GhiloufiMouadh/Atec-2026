"""CRATER Sentinel: Deep Space Network ground station (Earth-side receiver).

Run from VS Code or a terminal with:
    python earth_ground_station.py

This companion script simulates the transmission of the lunar rover's
telemetry from the Moon to Earth. It:

  * Reads the JSON Lines detection log and mission report written by the
    rover simulation (robot_simulation.py).
  * Models realistic one-way light-time delay (~1.28 s), packet framing,
    checksum verification, and occasional packet loss.
  * Displays a Mission Control dashboard on Earth showing decoded packets,
    signal strength, round-trip time, and a decoded event feed.
  * Writes a decoded Earth-side archive (earth_received_log.jsonl and
    earth_mission_summary.json) into simulation_data/.

The simulator uses only Python's standard library.

If no rover data exists yet, the ground station will generate a small
synthetic sample so the dashboard is never empty.
"""

from __future__ import annotations

import json
import math
import random
import sys
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterable

try:
    import tkinter as tk
    from tkinter import messagebox
except ImportError:
    tk = None
    messagebox = None


# ---------------------------------------------------------------------------
# Paths (shared with the rover simulation)
# ---------------------------------------------------------------------------
PROJECT_ROOT = Path(__file__).resolve().parent
DATA_DIRECTORY = PROJECT_ROOT / "simulation_data"
ROVER_LOG_PATH = DATA_DIRECTORY / "detection_log.jsonl"
ROVER_REPORT_PATH = DATA_DIRECTORY / "mission_report.json"

EARTH_LOG_PATH = DATA_DIRECTORY / "earth_received_log.jsonl"
EARTH_SUMMARY_PATH = DATA_DIRECTORY / "earth_mission_summary.json"

# ---------------------------------------------------------------------------
# Deep Space Network / link budget constants
# ---------------------------------------------------------------------------
ONE_WAY_LIGHT_TIME_S = 1.28          # Earth-Moon average one-way light time
FRAME_INTERVAL_MS = 420              # how fast packets are pushed through the GUI
PACKET_LOSS_PROBABILITY = 0.04       # ~4% of frames dropped and retransmitted
RETRANSMIT_DELAY_MS = 1400           # time before a lost frame is resent
EARTH_STATION = "DSN CANBERRA · DSS-43"
LUNAR_CRAFT = "L-SCOUT 01"
BAND = "S-BAND · 2.2 GHz"
DOWNLINK_RATE_KBPS = 64.0


HAZARD_STYLE = {
    "rock_formation": {"label": "Rock formation", "colour": "#ffb454", "priority": "MEDIUM"},
    "fissure":        {"label": "Fissure",       "colour": "#ff697f", "priority": "HIGH"},
    "hole":           {"label": "Lunar hole",    "colour": "#b78cff", "priority": "HIGH"},
    "dark_spot":      {"label": "Dark spot",     "colour": "#a8bbc8", "priority": "LOW"},
}


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------
@dataclass
class TelemetryPacket:
    """One framed, checksummed packet as received on Earth."""
    frame_id: int
    received_at_utc: str
    uplink_sent_at_utc: str
    one_way_delay_s: float
    signal_strength_dbm: float
    checksum_ok: bool
    retransmitted: bool
    payload: dict


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _now_utc() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def load_rover_records() -> list[dict]:
    """Load rover detections from JSON Lines, or synthesize a sample."""
    if ROVER_LOG_PATH.exists():
        records: list[dict] = []
        with ROVER_LOG_PATH.open("r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    records.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
        if records:
            return records

    # Fallback: build a small synthetic set so the dashboard is never empty.
    sample_features = [
        ("RK-01", "rock_formation", 6, 17),
        ("FS-01", "fissure", 10, 15),
        ("RK-02", "rock_formation", 16, 12),
        ("FS-02", "fissure", 20, 9),
        ("HL-01", "hole", 23, 11),
        ("DS-01", "dark_spot", 9, 10),
    ]
    synthetic: list[dict] = []
    for index, (fid, ftype, gx, gy) in enumerate(sample_features, start=1):
        synthetic.append({
            "sequence": index,
            "detected_at_utc": _now_utc(),
            "feature_id": fid,
            "feature_type": ftype,
            "priority": HAZARD_STYLE[ftype]["priority"],
            "grid_coordinate": {"x": gx, "y": gy},
            "estimated_position_m": {"x": 0.0, "y": 0.0},
            "confidence": 0.9,
            "uncertainty_m": 0.4,
            "rover_distance_m": 5.0 * index,
        })
    return synthetic


def signal_strength_for(frame_id: int) -> float:
    """Simulate slowly-varying received signal power (dBm)."""
    base = -118.0
    drift = 2.4 * math.sin(frame_id * 0.11)
    noise = random.uniform(-0.6, 0.6)
    return round(base + drift + noise, 2)


def checksum_of(payload: dict) -> int:
    """Deterministic checksum over the serialized payload."""
    raw = json.dumps(payload, sort_keys=True).encode("utf-8")
    return sum(raw) % 65536


def frame_packet(record: dict, frame_id: int, retransmitted: bool) -> TelemetryPacket:
    """Wrap a rover record into a received telemetry packet."""
    sent_at = datetime.now(timezone.utc).isoformat(timespec="seconds")
    return TelemetryPacket(
        frame_id=frame_id,
        received_at_utc=_now_utc(),
        uplink_sent_at_utc=sent_at,
        one_way_delay_s=ONE_WAY_LIGHT_TIME_S,
        signal_strength_dbm=signal_strength_for(frame_id),
        checksum_ok=True,
        retransmitted=retransmitted,
        payload=record,
    )


def write_earth_record(packet: TelemetryPacket) -> None:
    DATA_DIRECTORY.mkdir(exist_ok=True)
    with EARTH_LOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(asdict(packet)) + "\n")


def write_earth_summary(packets: Iterable[TelemetryPacket]) -> None:
    packet_list = list(packets)
    DATA_DIRECTORY.mkdir(exist_ok=True)
    payloads = [packet.payload for packet in packet_list]
    summary = {
        "mission": "CRATER Sentinel - Earth-side received archive",
        "generated_at_utc": _now_utc(),
        "ground_station": EARTH_STATION,
        "band": BAND,
        "one_way_light_time_s": ONE_WAY_LIGHT_TIME_S,
        "frames_received": len(packet_list),
        "frames_retransmitted": sum(packet.retransmitted for packet in packet_list),
        "feature_type_counts": {
            ftype: sum(1 for payload in payloads if payload.get("feature_type") == ftype)
            for ftype in ("fissure", "rock_formation", "hole", "dark_spot")
        },
        "packets": [asdict(packet) for packet in packet_list],
    }
    EARTH_SUMMARY_PATH.write_text(json.dumps(summary, indent=2), encoding="utf-8")


# ---------------------------------------------------------------------------
# Headless mode
# ---------------------------------------------------------------------------
def run_headless_reception() -> list[TelemetryPacket]:
    """Decode all rover records into framed packets without opening a window."""
    records = load_rover_records()
    packets: list[TelemetryPacket] = []
    rng = random.Random(7)
    for index, record in enumerate(records, start=1):
        retransmitted = rng.random() < PACKET_LOSS_PROBABILITY
        packets.append(frame_packet(record, index, retransmitted))
    return packets


# ---------------------------------------------------------------------------
# GUI: Earth Mission Control
# ---------------------------------------------------------------------------
class EarthGroundStation:
    """Tkinter Mission Control dashboard for the Earth-side receiver."""

    def __init__(self) -> None:
        if tk is None:
            raise RuntimeError("Tkinter is unavailable. Run with --headless instead.")
        try:
            self.root = tk.Tk()
        except tk.TclError as error:
            raise RuntimeError(
                "The selected Python interpreter cannot open Tkinter. Use a standard "
                "Python install with Tcl/Tk support, or run with --headless."
            ) from error

        self.root.title("CRATER Sentinel | Deep Space Network · Earth Ground Station")
        self.root.configure(background="#040a14")
        self.root.resizable(False, False)

        self.records = load_rover_records()
        self.packets: list[TelemetryPacket] = []
        self.index = 0
        self.running = False
        self.after_id: str | None = None
        self.rng = random.Random()
        self.sensor_values: dict[str, tk.Label] = {}

        self._build_interface()
        self._draw_signal_map()
        self._refresh_sidebar()

    # ----- UI construction -------------------------------------------------
    def _build_interface(self) -> None:
        header = tk.Frame(self.root, bg="#071426", padx=18, pady=12)
        header.pack(fill="x")
        title = tk.Frame(header, bg="#071426")
        title.pack(side="left")
        tk.Label(title, text="PROJECT C.R.A.T.E.R  /  DEEP SPACE NETWORK", fg="#63d9ff",
                 bg="#071426", font=("Arial", 9, "bold")).pack(anchor="w")
        tk.Label(title, text="Earth Ground Station", fg="#edf5ff", bg="#071426",
                 font=("Arial", 21, "bold")).pack(anchor="w", pady=(1, 0))
        tk.Label(title, text=f"{EARTH_STATION}  ·  {BAND}  ·  DOWNLINK {DOWNLINK_RATE_KBPS:.0f} kbps",
                 fg="#9cb0c5", bg="#071426", font=("Arial", 8, "bold")).pack(anchor="w", pady=(2, 0))

        badge = tk.Frame(header, bg="#112e38", padx=12, pady=8)
        badge.pack(side="right", anchor="ne")
        tk.Label(badge, text="●  AWAITING DOWNLINK", fg="#85e4b1", bg="#112e38",
                 font=("Arial", 9, "bold")).pack()
        tk.Label(badge, text="LUNAR LINK / 384 400 km", fg="#9cb0c5", bg="#112e38",
                 font=("Consolas", 8)).pack(pady=(2, 0))

        content = tk.Frame(self.root, bg="#040a14", padx=15, pady=15)
        content.pack(fill="both", expand=True)

        left = tk.Frame(content, bg="#040a14")
        left.pack(side="left", fill="both", expand=True)

        # Signal map panel
        signal_panel = tk.Frame(left, bg="#0b1c2e", highlightthickness=1,
                                highlightbackground="#36516c")
        signal_panel.pack(fill="both", expand=True)
        self._panel_title(signal_panel, "EARTH-MOON LINK",
                          "ONE-WAY LIGHT TIME 1.28 s · LIVE TRACK")
        self.signal_canvas = tk.Canvas(signal_panel, width=620, height=270,
                                       bg="#040914", highlightthickness=0)
        self.signal_canvas.pack(padx=1, pady=(0, 1))

        # Decoded packets panel
        packets_panel = tk.Frame(left, bg="#0b1c2e", highlightthickness=1,
                                 highlightbackground="#36516c")
        packets_panel.pack(fill="both", expand=True, pady=(12, 0))
        self._panel_title(packets_panel, "DECODED TELEMETRY",
                          "FRAME VERIFICATION · CHECKSUM OK")
        self.packets_box = tk.Text(packets_panel, height=12, bg="#040914", fg="#d5e4f4",
                                   insertbackground="#d5e4f4", relief="flat", wrap="none",
                                   font=("Consolas", 9), state="disabled")
        self.packets_box.pack(fill="both", expand=True, padx=1, pady=(0, 1))

        # Right sidebar
        side = tk.Frame(content, bg="#0b1c2e", width=350, padx=15, pady=14,
                        highlightthickness=1, highlightbackground="#36516c")
        side.pack(side="right", fill="both", padx=(14, 0))
        side.pack_propagate(False)

        self.status_label = tk.Label(side, text="GROUND STATION READY", fg="#85e4b1",
                                     bg="#0b1c2e", font=("Arial", 10, "bold"))
        self.status_label.pack(anchor="w")
        self.position_label = tk.Label(side, text="Frames received: 0 / 0",
                                       fg="#cbd8e7", bg="#0b1c2e", font=("Consolas", 10))
        self.position_label.pack(anchor="w", pady=(6, 0))
        self.metrics_label = tk.Label(
            side, text="Fissures: 0 · Rocks: 0\nHoles: 0 · Dark spots: 0",
            fg="#9cb0c5", bg="#0b1c2e", justify="left", font=("Arial", 10))
        self.metrics_label.pack(anchor="w", pady=(6, 10))

        tk.Label(side, text="LINK & STATION HEALTH", fg="#63d9ff", bg="#0b1c2e",
                 font=("Arial", 9, "bold")).pack(anchor="w")
        grid = tk.Frame(side, bg="#0b1c2e")
        grid.pack(fill="x", pady=(6, 11))
        for column in range(2):
            grid.grid_columnconfigure(column, weight=1)
        self._make_card(grid, "ANTENNA",    0, 0, "70 m · LOCKED", "#63d9ff")
        self._make_card(grid, "SIGNAL",     0, 1, "-118.0 dBm",   "#63d9ff")
        self._make_card(grid, "ROUND TRIP", 1, 0, "2.56 s",       "#85e4b1")
        self._make_card(grid, "FRAME LOSS", 1, 1, "0.0 %",        "#85e4b1")
        self._make_card(grid, "DOPPLER",    2, 0, "0 Hz · TRACK", "#b78cff")
        self._make_card(grid, "CLOCK",      2, 1, "UTC · SYNC",   "#b78cff")
        self._make_card(grid, "POWER",      3, 0, "NOMINAL",      "#ffb454")
        self._make_card(grid, "ARCHIVE",    3, 1, "0 KB",         "#85e4b1")

        tk.Label(side, text="GROUND STATION LOG", fg="#63d9ff", bg="#0b1c2e",
                 font=("Arial", 9, "bold")).pack(anchor="w")
        self.log_box = tk.Text(side, height=9, width=36, bg="#040a14", fg="#d5e4f4",
                               insertbackground="#d5e4f4", relief="flat", wrap="word",
                               font=("Consolas", 9), state="disabled")
        self.log_box.pack(fill="both", expand=True, pady=(7, 11))

