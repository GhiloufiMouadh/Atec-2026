        buttons.pack(fill="x")
        self.start_button = tk.Button(buttons, text="Begin reception",
                                      command=self.toggle_running, bg="#63d9ff",
                                      fg="#040a14", relief="flat",
                                      font=("Arial", 10, "bold"), padx=12, pady=8)
        self.start_button.pack(side="left", fill="x", expand=True)
        tk.Button(buttons, text="Reset", command=self.reset, bg="#17324c",
                  fg="#edf5ff", relief="flat", font=("Arial", 10, "bold"),
                  padx=12, pady=8).pack(side="left", padx=(8, 0))
        tk.Button(side, text="Export Earth archive", command=self.export_archive,
                  bg="#17324c", fg="#edf5ff", relief="flat",
                  font=("Arial", 10, "bold"), pady=8).pack(fill="x", pady=(8, 0))

        legend = tk.Frame(side, bg="#0b1c2e", pady=10)
        legend.pack(fill="x")
        for ftype in ("rock_formation", "fissure", "hole", "dark_spot"):
            style = HAZARD_STYLE[ftype]
            tk.Label(legend, text=f"●  {style['label']}  /  {style['priority']}",
                     fg=style["colour"], bg="#0b1c2e",
                     font=("Arial", 8, "bold")).pack(anchor="w")

    @staticmethod
    def _panel_title(parent: tk.Frame, label: str, detail: str) -> None:
        title = tk.Frame(parent, bg="#0b1c2e", padx=11, pady=7)
        title.pack(fill="x")
        tk.Label(title, text=label, fg="#63d9ff", bg="#0b1c2e",
                 font=("Arial", 9, "bold")).pack(side="left")
        tk.Label(title, text=detail, fg="#71869a", bg="#0b1c2e",
                 font=("Consolas", 8)).pack(side="right")

    def _make_card(self, parent: tk.Frame, name: str, row: int, column: int,
                   initial_value: str, colour: str) -> None:
        card = tk.Frame(parent, bg="#10283a", padx=8, pady=6)
        card.grid(row=row, column=column, sticky="nsew", padx=2, pady=2)
        tk.Label(card, text=name, fg="#9cb0c5", bg="#10283a",
                 font=("Arial", 7, "bold")).pack(anchor="w")
        value = tk.Label(card, text=initial_value, fg=colour, bg="#10283a",
                         font=("Consolas", 8, "bold"))
        value.pack(anchor="w", pady=(2, 0))
        self.sensor_values[name] = value

    # ----- drawing ---------------------------------------------------------
    def _draw_signal_map(self) -> None:
        canvas = self.signal_canvas
        canvas.delete("all")
        width = int(canvas["width"])
        height = int(canvas["height"])

        # Starfield background
        rng = random.Random(11)
        for _ in range(90):
            x = rng.randint(0, width)
            y = rng.randint(0, height)
            canvas.create_oval(x, y, x + 1, y + 1, fill="#8fb6d6", outline="")

        earth_x, earth_y, earth_r = 90, height // 2, 46
        moon_x, moon_y, moon_r = width - 90, height // 2, 34

        # Earth
        canvas.create_oval(earth_x - earth_r, earth_y - earth_r,
                           earth_x + earth_r, earth_y + earth_r,
                           fill="#1d4a70", outline="#63d9ff", width=2)
        canvas.create_arc(earth_x - earth_r, earth_y - earth_r,
                          earth_x + earth_r, earth_y + earth_r,
                          start=30, extent=140, style="chord",
                          fill="#2f7f5a", outline="")
        canvas.create_text(earth_x, earth_y + earth_r + 14, text="EARTH",
                           fill="#cfe8ff", font=("Arial", 9, "bold"))
        canvas.create_text(earth_x, earth_y + earth_r + 27, text=EARTH_STATION,
                           fill="#7f9cb5", font=("Consolas", 7))

        # Moon
        canvas.create_oval(moon_x - moon_r, moon_y - moon_r,
                           moon_x + moon_r, moon_y + moon_r,
                           fill="#8b8f92", outline="#d7dee2", width=2)
        for cx, cy, cr in ((-10, -6, 7), (8, 4, 5), (-4, 12, 4), (12, -10, 4)):
            canvas.create_oval(moon_x + cx - cr, moon_y + cy - cr,
                               moon_x + cx + cr, moon_y + cy + cr,
                               fill="#6f7477", outline="")
        canvas.create_text(moon_x, moon_y + moon_r + 14, text="MOON",
                           fill="#e8f0f4", font=("Arial", 9, "bold"))
        canvas.create_text(moon_x, moon_y + moon_r + 27, text=LUNAR_CRAFT,
                           fill="#7f9cb5", font=("Consolas", 7))

        # Downlink beam with animated packets
        mid_y = height // 2
        canvas.create_line(earth_x + earth_r, mid_y, moon_x - moon_r, mid_y,
                           fill="#1f4a63", width=6)
        canvas.create_line(earth_x + earth_r, mid_y, moon_x - moon_r, mid_y,
                           fill="#63d9ff", width=1, dash=(4, 6))

        total = max(1, len(self.records))
        progress = self.index / total
        for i in range(24):
            t = i / 23.0
            px = moon_x - moon_r + (earth_x + earth_r - (moon_x - moon_r)) * t
            py = mid_y + math.sin(t * math.pi * 4 + self.index * 0.4) * 6
            travelled = t <= progress
            colour = "#63d9ff" if travelled else "#2a4a5e"
            radius = 3 if travelled else 2
            canvas.create_oval(px - radius, py - radius, px + radius, py + radius,
                               fill=colour, outline="")

        # Link readouts
        canvas.create_text(width // 2, 22,
                           text=f"DOWNLINK  ·  FRAME {self.index:03d} / {total:03d}",
                           fill="#d5eaf8", font=("Consolas", 9, "bold"))
        canvas.create_text(width // 2, height - 18,
                           text=f"ONE-WAY DELAY {ONE_WAY_LIGHT_TIME_S:.2f} s  ·  "
                                f"ROUND TRIP {ONE_WAY_LIGHT_TIME_S * 2:.2f} s",
                           fill="#85e4b1", font=("Consolas", 8, "bold"))

    # ----- reception loop --------------------------------------------------
    def _append_packet_line(self, packet: TelemetryPacket) -> None:
        payload = packet.payload
        ftype = payload.get("feature_type", "unknown")
        style = HAZARD_STYLE.get(ftype, {"label": ftype, "colour": "#d5e4f4"})
        grid = payload.get("grid_coordinate", {})
        line = (
            f"FRAME {packet.frame_id:03d}  {packet.received_at_utc}  "
            f"{packet.signal_strength_dbm:>7.2f} dBm  "
            f"{'RETX' if packet.retransmitted else ' OK '}  "
            f"{style['label'].upper():<14}  "
            f"({grid.get('x', 0):02d},{grid.get('y', 0):02d})  "
            f"conf {payload.get('confidence', 0):.2f}\n"
        )
        self.packets_box.configure(state="normal")
        self.packets_box.insert("end", line)
        self.packets_box.see("end")
        self.packets_box.configure(state="disabled")

    def _log(self, message: str, colour: str = "#d5e4f4") -> None:
        stamp = datetime.now(timezone.utc).strftime("%H:%M:%S")
        self.log_box.configure(state="normal")
        self.log_box.insert("1.0", f"[{stamp}] {message}\n")
        self.log_box.configure(state="disabled")

    def _refresh_sidebar(self) -> None:
        total = len(self.records)
        self.position_label.configure(text=f"Frames received: {self.index} / {total}")

        payloads = [packet.payload for packet in self.packets]
        counts = {
            ftype: sum(1 for p in payloads if p.get("feature_type") == ftype)
            for ftype in ("fissure", "rock_formation", "hole", "dark_spot")
        }
        self.metrics_label.configure(
            text=(f"Fissures: {counts['fissure']} · Rocks: {counts['rock_formation']}\n"
                  f"Holes: {counts['hole']} · Dark spots: {counts['dark_spot']}")
        )

        if self.packets:
            last = self.packets[-1]
            self.sensor_values["SIGNAL"].configure(
                text=f"{last.signal_strength_dbm:.1f} dBm")
        loss = (sum(p.retransmitted for p in self.packets) / len(self.packets) * 100
                if self.packets else 0.0)
        self.sensor_values["FRAME LOSS"].configure(
            text=f"{loss:.1f} %",
            fg="#ffb454" if loss > 5 else "#85e4b1")
        archive_kb = EARTH_LOG_PATH.stat().st_size / 1024 if EARTH_LOG_PATH.exists() else 0.0
        self.sensor_values["ARCHIVE"].configure(text=f"{archive_kb:.1f} KB")

    def _receive_next(self) -> None:
        if not self.running:
            return
        if self.index >= len(self.records):
            self.running = False
            write_earth_summary(self.packets)
            self.start_button.configure(text="Reception complete", state="disabled")
            self.status_label.configure(text="DOWNLINK COMPLETE · ARCHIVE SAVED",
                                        fg="#85e4b1")
            self._log("Downlink complete. Earth archive written.", "#85e4b1")
            return

        record = self.records[self.index]
        retransmitted = self.rng.random() < PACKET_LOSS_PROBABILITY
        packet = frame_packet(record, self.index + 1, retransmitted)
        self.packets.append(packet)
        write_earth_record(packet)
        self._append_packet_line(packet)
        self.index += 1

        ftype = record.get("feature_type", "unknown")
        style = HAZARD_STYLE.get(ftype, {"label": ftype, "colour": "#d5e4f4"})
        self.status_label.configure(
            text=f"DECODED: {style['label'].upper()}", fg=style["colour"])
        if retransmitted:
            self._log(f"Frame {packet.frame_id} lost — retransmitted and decoded.",
                      "#ffb454")
        else:
            self._log(f"Frame {packet.frame_id} received · checksum OK.", "#85e4b1")

        self._draw_signal_map()
        self._refresh_sidebar()

        delay = FRAME_INTERVAL_MS + (RETRANSMIT_DELAY_MS if retransmitted else 0)
        self.after_id = self.root.after(delay, self._receive_next)

    def toggle_running(self) -> None:
        if self.running:
            self.running = False
            if self.after_id:
                self.root.after_cancel(self.after_id)
            self.start_button.configure(text="Resume reception")
            self.status_label.configure(text="RECEPTION PAUSED", fg="#ffb454")
            self._log("Reception paused by operator.", "#ffb454")
        else:
            self.running = True
            self.start_button.configure(text="Pause reception")
            self.status_label.configure(text="DOWNLINK ACTIVE", fg="#85e4b1")
            self._log("Downlink acquisition established.", "#85e4b1")
            self._receive_next()

    def reset(self) -> None:
        self.running = False
        if self.after_id:
            self.root.after_cancel(self.after_id)
        self.packets.clear()
        self.index = 0
        self.packets_box.configure(state="normal")
        self.packets_box.delete("1.0", "end")
        self.packets_box.configure(state="disabled")
        self.log_box.configure(state="normal")
        self.log_box.delete("1.0", "end")
        self.log_box.configure(state="disabled")
        self.start_button.configure(text="Begin reception", state="normal")
        self.status_label.configure(text="GROUND STATION READY", fg="#85e4b1")
        self._draw_signal_map()
        self._refresh_sidebar()

    def export_archive(self) -> None:
        write_earth_summary(self.packets)
        if messagebox:
            messagebox.showinfo("Earth archive exported",
                                f"Saved to:\n{EARTH_SUMMARY_PATH}")

    def run(self) -> None:
        self.root.mainloop()


