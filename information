# Entry point
# ---------------------------------------------------------------------------
def main() -> int:
    if "--headless" in sys.argv:
        packets = run_headless_reception()
        write_earth_summary(packets)
        print(f"Earth ground station received {len(packets)} telemetry frames.")
        print(f"Archive written to: {EARTH_SUMMARY_PATH}")
        return 0

    EarthGroundStation().run()
    return 0


